# Browser-exposed configuration. These values are included in the built app.
# Use only public or publishable credentials here.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_GOOGLE_GEOCODE_KEY=
REACT_APP_MAP_TILE_URL=
REACT_APP_MAP_TILE_ATTRIBUTION=
REACT_APP_MAP_TILE_MAX_ZOOM=

# Admin API configuration. Never expose these through a REACT_APP_, VITE_, or
# NEXT_PUBLIC_ variable.
ADMIN_PORTAL_PASSWORD=
ADMIN_SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Optional server-side providers.
GOOGLE_PLACES_API_KEY=
BUG_REPORT_SMTP_HOST=
BUG_REPORT_SMTP_PORT=587
BUG_REPORT_SMTP_USER=
BUG_REPORT_SMTP_PASS=

# Optional diagnostics/review inputs, not scheduled worker configuration.
# Production queues and state belong to the private external workspace.
# Legacy manual-tool checkpoints must be migrated to this existing directory;
# the tools fail closed when it is unset, missing, or inside this checkout.
PRIVATE_PIPELINE_STATE_DIR=
# The older Taco status lane stays disabled; this does not disable its runtime.
QUEUE_DB_PATH=
PIPELINE_STATUS_ROOT=
PIPELINE_STATUS_PIZZA_LANE=legacy
PIPELINE_STATUS_TACO_LANE=disabled
PIPELINE_DEPLOYMENT_ID=
SOURCE_REVIEW_DIR=
SOURCE_REVIEW_QUEUE_CSV=

# Read-only compatibility status from the external food runtime. Set this to
# that private runtime workspace's scripts directory, never the code repository.
FOOD_PIPELINE_STATUS_ROOT=
FOOD_PIPELINE_STATUS_MAX_AGE_MINUTES=360
