{
  "version": 1,
  "entities": ["pizza", "taco"],
  "canonical_tables": {
    "pizza": "pizza_places",
    "taco": "taco_places"
  },
  "local_only_tables": ["place_sources", "source_review_queue"],
  "sync_target": "pizza_places",
  "primary_fields": {
    "pizza_style": "style",
    "price": "price_range",
    "business_lifecycle": "lifecycle_status",
    "personal_status": "status"
  },
  "public_fields": {
    "base": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating"],
    "pizza": {
      "map": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "menu_url", "phone", "hours", "price_range", "brand", "operator", "lifecycle_status", "lifecycle_replaced_by_id"],
      "detail": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "menu_url", "phone", "hours", "price_range", "brand", "operator", "lifecycle_status", "lifecycle_replaced_by_id"],
      "legacy_map": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "phone", "price_range", "brand", "operator"],
      "legacy_detail": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "phone", "price_range", "brand", "operator"]
    },
    "taco": {
      "map": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "menu_url", "phone", "hours", "price_range", "brand", "operator", "lifecycle_status", "lifecycle_replaced_by_id"],
      "detail": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "menu_url", "phone", "hours", "price_range", "brand", "operator", "lifecycle_status", "lifecycle_replaced_by_id"],
      "legacy_map": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "phone", "price_range", "brand", "operator"],
      "legacy_detail": ["id", "name", "lat", "lng", "address", "google_place_id", "state", "status", "style", "price", "rating", "website_url", "phone", "price_range", "brand", "operator"]
    }
  },
  "legacy_field_aliases": {
    "price": "price_range"
  },
  "source_precedence": [
    "official_website",
    "osm",
    "fsq_os_places",
    "all_the_places",
    "overture_places",
    "wikidata"
  ],
  "fields": {
    "identity": ["id", "name", "lat", "lng", "address", "state", "google_place_id"],
    "editorial": ["status", "rating", "notes", "photos", "lifecycle_status", "lifecycle_replaced_by_id"],
    "source_factual": [
      "website_url", "menu_url", "phone", "email", "instagram_url",
      "facebook_url", "twitter_url", "whatsapp", "hours", "delivery",
      "takeaway", "drive_through", "outdoor_seating", "indoor_seating",
      "wheelchair", "brand", "brand_wikidata", "operator", "operator_wikidata",
      "osm_tags", "osm_last_fetched_at", "osm_fetch_status", "osm_fetch_error",
      "address_source", "scrape_method", "scrape_notes", "menu_data",
      "menu_parse_confidence", "menu_parse_notes", "menu_last_parsed_at"
    ],
    "inferred": ["style", "price", "price_range", "style_confidence", "enrichment_status", "last_enriched_at", "enrichment_agent", "enrichment_run_id"],
    "operational": ["created_at", "updated_at", "qa_status", "qa_schema_version"]
  },
  "allowed_values": {
    "style": ["New York", "New Haven / Connecticut", "Chicago Deep Dish", "Chicago Tavern", "Detroit", "Sicilian", "Grandma", "Neapolitan", "Roman", "California", "St. Louis", "Tavern", "Standard Round", "Other", "Unknown"],
    "price_range": ["$", "$$", "$$$", "$$$$"],
    "style_confidence": ["confirmed", "inferred"],
    "enrichment_status": ["pending", "enriched", "failed"],
    "lifecycle_status": ["closed", "replaced", "demolished"]
  },
  "promotion": {
    "auto_fill_if_blank": ["website_url", "phone"],
    "manual_review_only": ["name", "address", "lat", "lng", "state", "google_place_id"],
    "blocked_from_source_promotion": ["style", "price", "price_range", "rating", "notes", "status", "photos", "lifecycle_status", "lifecycle_replaced_by_id"]
  },
  "editorial_rules": {
    "rating": {
      "normal_scale": {
        "minimum": 0,
        "maximum": 10
      },
      "legacy_out_of_scale_policy": "preserve_for_personal_history_and_include_in_editorial_filters"
    },
    "picks": {
      "owner": "Anthony/editorial workflow",
      "minimum_rating_by_entity": {
        "pizza": 8,
        "taco": 8
      },
      "public_label": "Anthony's Picks"
    }
  }
}
