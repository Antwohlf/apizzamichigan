{
  "name": "apizza-michigan",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "@supabase/supabase-js": "^2.48.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "leaflet-rotatedmarker": "^0.2.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^2.1.4"
  },
  "homepage": "https://apizzamichigan.com",
  "proxy": "http://localhost:5050",
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run generate-stats && react-scripts build",
    "generate-stats": "node scripts/generate-dashboard-stats.mjs",
    "readiness": "node scripts/ops/project-readiness-report.mjs",
    "lifecycle-report": "node scripts/ops/lifecycle-quality-report.mjs",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "react-scripts test",
    "typecheck": "tsc --noEmit",
    "eject": "react-scripts eject",
    "start:server": "node server/index.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/__mocks__/react-router-dom.js",
      "^react-leaflet$": "<rootDir>/__mocks__/react-leaflet.js",
      "^leaflet$": "<rootDir>/__mocks__/leaflet.js",
      "^leaflet-rotatedmarker$": "<rootDir>/__mocks__/leaflet-rotatedmarker.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "gh-pages": "^6.3.0",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5"
  }
}
