<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apizzamichigan.classifier-retry-feeder</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /srv/apizzamichigan &amp;&amp; /usr/local/bin/node scripts/ops/feed-classifier-retries.mjs --apply</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/srv/apizzamichigan</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/tmp/apizzamichigan/classifier-retry-feeder.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/apizzamichigan/classifier-retry-feeder.log</string>
</dict>
</plist>
