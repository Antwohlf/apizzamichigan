<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apizzamichigan.supabase-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /srv/apizzamichigan &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; /usr/local/bin/node scripts/ops/auto-guarded-supabase-sync.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>APIZZA_SYNC_HOURS</key>
    <string>168</string>
    <key>APIZZA_SYNC_BATCH</key>
    <string>100</string>
    <key>APIZZA_SYNC_MAX_BATCHES</key>
    <string>1</string>
    <key>APIZZA_SYNC_CHECKPOINT</key>
    <string>scripts/.supabase-sync-checkpoint.json</string>
    <key>APIZZA_SYNC_SAMPLE</key>
    <string>10</string>
    <key>APIZZA_SYNC_INSERT_MISSING_REVIEWED_NEW</key>
    <string>true</string>
    <key>APIZZA_SYNC_RECONCILE_CHECKPOINT</key>
    <string>scripts/.supabase-reconcile-checkpoint.json</string>
    <key>APIZZA_SYNC_RECONCILE_BATCH</key>
    <string>100</string>
    <key>APIZZA_SYNC_RECONCILE_MAX_BATCHES</key>
    <string>1</string>
    <key>APIZZA_SYNC_CONCURRENCY</key>
    <string>1</string>
    <key>ENABLE_LIFECYCLE_SYNC</key>
    <string>1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/srv/apizzamichigan</string>

  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/tmp/apizzamichigan/supabase-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/apizzamichigan/supabase-sync.log</string>
</dict>
</plist>
