<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apizzamichigan.taco-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /srv/apizzamichigan &amp;&amp; APIZZA_SYNC_ENTITY=taco APIZZA_SYNC_BULK_RPC=1 ENABLE_LIFECYCLE_SYNC=1 /usr/local/bin/node scripts/ops/auto-guarded-supabase-sync.mjs --entity taco --bulk-rpc --checkpoint scripts/.taco-supabase-sync-checkpoint.json</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>APIZZA_SYNC_ENTITY</key><string>taco</string>
    <key>APIZZA_SYNC_BULK_RPC</key><string>1</string>
    <key>APIZZA_SYNC_STATUS_FILE</key><string>scripts/.taco-supabase-sync-status.json</string>
    <key>ENABLE_LIFECYCLE_SYNC</key><string>1</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/srv/apizzamichigan</string>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key><string>/tmp/apizzamichigan/taco-sync.log</string>
  <key>StandardErrorPath</key><string>/tmp/apizzamichigan/taco-sync.log</string>
</dict>
</plist>
