<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apizzamichigan.scraper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /srv/apizzamichigan &amp;&amp; SCRAPE_REQUEUE_BATCH=0 SCRAPE_FETCH_TIMEOUT_MS=10000 SCRAPE_MAX_RETRIES=1 SCRAPE_BROWSER_TIMEOUT_MS=30000 SCRAPE_BROWSER_FALLBACK_DOMAINS=cpk.com,telepizza.es,pizzahut.com,roundtablepizza.com,costco.com,ozzyapizza.com SCRAPE_BROWSER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" /usr/local/bin/node scripts/enrichment/agents/web-scraper.mjs --worker-id launchd-scraper</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/srv/apizzamichigan</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/tmp/apizzamichigan/scraper.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/apizzamichigan/scraper.log</string>
</dict>
</plist>
